# Production image: static Vite build served by unprivileged nginx.
# Build:  docker build -f Dockerfile.prod -t devops-maturity-frontend .
# (The dev compose stack uses ./Dockerfile, which runs the Vite dev server.)

FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
