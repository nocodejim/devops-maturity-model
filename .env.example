# Copy to .env and adjust. docker-compose reads this file automatically.
# NEVER commit .env — it is gitignored.

# --- Database ---
POSTGRES_USER=devops
POSTGRES_PASSWORD=devops123
POSTGRES_DB=devops_maturity

# --- Backend ---
# Generate a real key:  openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=True

# Seed the well-known dev admin (admin@example.com) on startup.
# Only honored when DEBUG is also true. Leave False in any shared environment.
CREATE_DEV_USERS=True

# Cross-origin browser access to the backend (comma-separated).
# Not needed for the default setup — the frontend proxies /api same-origin.
# ALLOWED_ORIGINS=http://localhost:8673

# --- Deploy only (docker-compose.deploy.yml) ---
# BACKEND_IMAGE=buckeye90/devops-maturity-backend:2.1
# FRONTEND_IMAGE=buckeye90/devops-maturity-frontend:2.1
